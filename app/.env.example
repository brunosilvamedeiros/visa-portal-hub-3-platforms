# Configuração das APIs do Portal Hub (Desenvolvimento Local ou Produção Cloud)

# 1. Supabase Cloud (Banco de Dados & Auth)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# 2. BookStack Wiki API
VITE_BOOKSTACK_URL=http://localhost:8080
VITE_BOOKSTACK_TOKEN_ID=seu-token-id
VITE_BOOKSTACK_TOKEN_SECRET=seu-token-secret

# 3. OpenProject API
VITE_OPENPROJECT_URL=http://localhost:8082
VITE_OPENPROJECT_API_KEY=sua-api-key-openproject
